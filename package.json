{
  "name": "trialbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "wrangler dev",
    "local": "tsx scripts/local.ts",
    "local:national": "tsx scripts/local.ts --mode=national",
    "local:check": "tsx scripts/local-check.ts",
    "local:seed": "tsx scripts/local.ts --mode=seed",
    "setup": "npm run models:fetch && npm run ingest:seed",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "seed:fetch": "tsx scripts/fetch-seed.ts",
    "zip:fetch": "tsx scripts/fetch-zip.ts",
    "ingest": "tsx scripts/ingest/index.ts",
    "ingest:seed": "tsx scripts/ingest/index.ts --source=seed",
    "db:seed:local": "wrangler d1 execute trialbridge --local --file=data/build/criteria.sql",
    "prebuild": "tsx scripts/ensure-data.ts",
    "build": "next build && tsx scripts/postbuild.ts && wrangler deploy --dry-run --outdir .wrangler/dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "rm -rf .wrangler/e2e-out && mkdir -p .wrangler && cp -R out .wrangler/e2e-out && npm run db:migrate:local && npm run db:seed:local && wrangler d1 execute trialbridge --local --command \"DELETE FROM kv\" && playwright test",
    "build:web": "next build && tsx scripts/postbuild.ts",
    "db:migrate:local": "wrangler d1 migrations apply trialbridge --local",
    "preview": "npm run db:migrate:local && npm run db:seed:local && wrangler dev",
    "ingest:llm": "tsx scripts/ingest/llm.ts",
    "eval": "tsx scripts/eval/run.ts",
    "eval:labels": "tsx scripts/eval/make-labels.ts",
    "i18n:translate": "tsx scripts/i18n/translate.ts",
    "i18n:manifest": "tsx scripts/i18n/translate.ts --manifest",
    "fonts:fetch": "tsx scripts/fetch-fonts.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "minisearch": "7.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "shadcn": "file:vendor/shadcn-css",
    "tailwind-merge": "3.7.0",
    "zod": "4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "fflate": "0.8.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
  },
  "overrides": {
    "fast-glob": "file:./vendor/fast-glob",
    "sharp": "0.35.5"
  }
}
